{
  "name": "boop-runner",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "description": "BoopPr runner: clones a PR, runs the multi-lens review via OpenCode, and posts a friendly summary with inline comments",
  "scripts": {
    "start": "node src/index.mjs",
    "test": "bun test src/*.test.mjs src/lib/*.test.mjs",
    "test:node": "node --test src/*.test.mjs src/lib/*.test.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@octokit/rest": "22.0.1",
    "@openrouter/sdk": "1.2.8",
    "jsonwebtoken": "9.0.3",
    "opencode-ai": "1.18.10"
  }
}
