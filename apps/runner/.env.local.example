# Local-run env for the boop runner.
#
# Usage:
#   1. Copy this file to .env.local: `cp .env.local.example .env.local`
#   2. Fill in OPENROUTER_API_KEY in .env.local.
#   3. Run in a subshell so the key does not leak to your shell
#      history: `(source .env.local && npm run local-run)`.
#   4. The wrapper verifies the skill mount and pre-staged repo
#      before invoking the runner.
#
# Stage the skill mount + repo once per session:
#   cp -R ../k8s/base/runner-config/skills/. /tmp/boop-runner/skills/
#   gh repo clone qubitquilt/boop /tmp/boop-runner/repo
#   git -C /tmp/boop-runner/repo fetch origin feature/openrouter-sdk-swap
#   git -C /tmp/boop-runner/repo checkout <PR_HEAD_SHA>
#
# QUB-136: the wrapper runs the .ts source via tsx, no `tsc`
# build step needed locally. Production goes through `tsc →
# dist/index.js`; the local dev loop bypasses the build for
# iteration speed.

# --- PR metadata (pin to the PR you want to review) ---
export PR_OWNER=qubitquilt
export PR_REPO=boop
export PR_NUMBER=191
export PR_HEAD_SHA=47bc359a8d3c0650874aa58d8b3a30a531b2f2fc
export PR_BASE_REF=main

# --- GitHub App ---
export GITHUB_APP_ID=4420607
export GITHUB_APP_INSTALLATION_ID=149974124
export BOOP_GITHUB_APP_PRIVATE_KEY_PATH=~/Downloads/booppr.2026-07-28.private-key.pem

# --- OpenRouter ---
# Required: the wrapper writes this into BOOP_OPENROUTER_API_KEY_PATH
# with mode 0400 so the runner's readSecretFile guard passes.
# Replace with your key. Do not commit this file.
export OPENROUTER_API_KEY=sk-or-v1-REPLACE-ME
export BOOP_OPENROUTER_API_KEY_PATH=/tmp/boop-secrets/openrouter-api-key
export OPENROUTER_MODEL=minimax/minimax-m3

# --- Local mounts (overrides the production /work + /home/opencode) ---
# BOOP_REPO_DIR points at the cloned PR repo. BOOP_CONFIG_SRC points
# at the parent of skills/ — the runner reads ${CONFIG_SRC}/skills/boop/.
export BOOP_REPO_DIR=/tmp/boop-runner/repo
export BOOP_CONFIG_SRC=/tmp/boop-runner

# --- Skill mount staging (one-time per session) ---
#   mkdir -p /tmp/boop-runner
#   cp -R apps/k8s/base/runner-config/skills /tmp/boop-runner/skills
#   gh repo clone qubitquilt/boop /tmp/boop-runner/repo
#   git -C /tmp/boop-runner/repo fetch origin feature/openrouter-sdk-swap
#   git -C /tmp/boop-runner/repo checkout <PR_HEAD_SHA>

# --- Tool toggle (set to 0 for a no-tools baseline run) ---
# export BOOP_TOOLS_ENABLED=0